# ─────────────────────────────────────────────────────────────
# Analytics
# ─────────────────────────────────────────────────────────────

# GA4 measurement ID. Loads the client tag on the site.
# Set in Vercel for Production AND Preview — without it in Preview there is no
# way to verify measurement before it reaches production.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# GA4 Measurement Protocol secret. Server-only — never prefix with NEXT_PUBLIC.
# Powers redirect measurement: a 307 renders no HTML, so the client tag can
# never see a QR scan. Without this the redirects still work, they are simply
# not counted.
# Create at: GA4 → Admin → Data Streams → [stream] → Measurement Protocol API secrets
GA4_API_SECRET=

# ─────────────────────────────────────────────────────────────
# Booking email (Resend) — see .env.local.example for detail
# Without RESEND_API_KEY the booking form returns 503.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
